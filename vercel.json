    { "source": "/tub", "destination": "/upsell-2-mindor-tub.html" },
    { "source": "/squeeze", "destination": "/squeeze-brain-noise.html" },
    { "source": "/thankyou", "destination": "/funnel-thankyou.html" },
    { "source": "/protocol", "destination": "/protocolcard.html" },
    { "source": "/fbquiz1", "destination": "/quiz-focus-quiz.html" },
    { "source": "/quiz", "destination": "/quiz-focus-quiz.html" },
    { "source": "/quiz-confirm", "destination": "/quiz-focus-confirm.html" },
    { "source": "/quiz-upsell", "destination": "/quiz-focus-upsell-1.html" },
    { "source": "/quiz-downsell", "destination": "/quiz-focus-downsell.html" },
    { "source": "/quiz-thankyou", "destination": "/quiz-focus-thankyou.html" },
    { "source": "/tracker", "destination": "/productivity-tracker.html" },
    { "source": "/fb/lander/relaunch", "destination": "/mindor-presales.html" },
    { "source": "/lander", "destination": "/mindor-lander-v3.html" },
